<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      QUERY_ALL_PACKAGES adalah izin sensitif dan harus dibenarkan pada Play
      Console. Tanpa ini, pemindaian berdasarkan label tidak melihat apa pun di
      Android 11+, sehingga pemeriksaan aplikasi terlarang jadi tidak berguna.
      Blok <queries> di bawah menangani daftar package yang sudah diketahui
      tanpa memerlukan izin luas, jadi izin ini hanya menambah jaring pengaman
      berbasis label. Hapus baris ini bila kebijakan Play Store menolaknya.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Visibilitas paket eksplisit: berfungsi tanpa izin sensitif. -->
    <queries>
        <package android:name="com.openai.chatgpt" />
        <package android:name="com.anthropic.claude" />
        <package android:name="ai.perplexity.app.android" />
        <package android:name="com.deepseek.chat" />
        <package android:name="com.google.android.apps.bard" />
        <package android:name="com.google.android.apps.gemini" />
        <package android:name="com.microsoft.copilot" />
        <package android:name="com.microsoft.bing" />
        <package android:name="com.quora.android" />
        <package android:name="ai.x.grok" />
        <package android:name="com.character.ai" />
        <package android:name="com.meta.ai" />
        <package android:name="com.alibaba.tongyi" />
        <package android:name="com.moonshot.kimichat" />
        <package android:name="com.larus.nova" />
        <package android:name="chat.mistral.ai" />
        <package android:name="com.phind.app" />
        <package android:name="com.teamviewer.quicksupport.market" />
        <package android:name="com.teamviewer.teamviewer.market.mobile" />
        <package android:name="com.anydesk.anydeskandroid" />
        <package android:name="com.rustdesk" />
        <package android:name="com.microsoft.rdc.androidx" />
        <package android:name="com.splashtop.remote.pad.v2" />
        <package android:name="com.hecorat.screenrecorder.free" />
        <package android:name="com.kimcy929.screenrecorder" />
        <package android:name="com.duapps.recorder" />

        <intent>
            <action android:name="android.intent.action.PICK" />
            <data android:mimeType="image/*" />
        </intent>
    </queries>

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:targetApi="34">

        <activity
            android:name=".SplashScreenActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.Splash"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".InputAddressActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.Exam"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".QRScanActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.Exam"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".PinnedActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <receiver
            android:name=".DeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_receiver" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
