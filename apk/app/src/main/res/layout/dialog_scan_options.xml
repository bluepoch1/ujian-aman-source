<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/space_6"
    android:layout_marginEnd="@dimen/space_6"
    android:background="@drawable/surface_dialog"
    android:orientation="vertical"
    android:padding="@dimen/space_6">

    <TextView
        style="@style/Text.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/scan_source_title" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_scan_camera"
        style="@style/Button.Secondary"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/space_4"
        android:drawableStart="@drawable/ic_camera"
        android:drawablePadding="@dimen/space_3"
        android:drawableTint="@color/ink_muted"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/space_4"
        android:paddingEnd="@dimen/space_4"
        android:text="@string/scan_camera" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_scan_gallery"
        style="@style/Button.Secondary"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/space_2"
        android:drawableStart="@drawable/ic_image"
        android:drawablePadding="@dimen/space_3"
        android:drawableTint="@color/ink_muted"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/space_4"
        android:paddingEnd="@dimen/space_4"
        android:text="@string/scan_gallery" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_scan_cancel"
        style="@style/Button.Ghost"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/space_2"
        android:text="@string/scan_cancel" />

</LinearLayout>