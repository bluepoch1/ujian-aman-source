<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/space_6"
    android:layout_marginEnd="@dimen/space_6"
    android:background="@drawable/surface_dialog"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_6"
    android:paddingEnd="@dimen/space_6"
    android:paddingTop="@dimen/space_6"
    android:paddingBottom="@dimen/space_5">

    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/icon_tile_danger">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_shield"
            app:tint="@color/danger"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <TextView
        style="@style/Text.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:text="@string/check_apps_title" />

    <TextView
        style="@style/Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_1"
        android:text="@string/check_apps_body" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:maxHeight="260dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/container_apps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_sudah_hapus"
        style="@style/Button.Primary"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/space_4"
        android:text="@string/check_apps_done" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_keluar_security"
        style="@style/Button.Ghost"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/space_1"
        android:text="@string/check_quit"
        android:textColor="@color/danger" />

</LinearLayout>