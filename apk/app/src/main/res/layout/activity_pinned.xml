<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="@dimen/page_gutter"
    android:paddingEnd="@dimen/page_gutter">

    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/icon_tile_accent">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_pin"
            app:tint="@color/accent"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <TextView
        style="@style/Text.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:text="@string/pinned_title" />

    <TextView
        style="@style/Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:gravity="center"
        android:text="@string/pinned_body" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_mengerti"
        style="@style/Button.Primary"
        android:layout_width="wrap_content"
        android:layout_marginTop="@dimen/space_6"
        android:minWidth="200dp"
        android:text="@string/pinned_understood" />

</LinearLayout>