<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2" />

    <!-- Logo -->
    <FrameLayout
        android:id="@+id/logo_container"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_gravity="center"
        android:background="@drawable/logo_bg_modern">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/logo_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_shield"
            app:tint="@color/accent"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_4" />

    <!-- App name -->
    <TextView
        android:id="@+id/tv_app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="Ujian Aman"
        android:textColor="@color/ink"
        android:textSize="22sp"
        android:letterSpacing="0.02"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Status badge -->
    <LinearLayout
        android:id="@+id/badge_device"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/badge_modern"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <View
            android:id="@+id/dot_status"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/dot_green" />

        <TextView
            android:id="@+id/badge_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
            android:textSize="13sp"
            android:textColor="@color/success"
            tools:text="Perangkat Aman" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Form section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingBottom="@dimen/space_8">

        <!-- Token label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Token Ujian"
            android:textColor="@color/ink_muted"
            android:textSize="13sp"
            android:letterSpacing="0.02" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="8dp" />

        <!-- Token input row -->
        <LinearLayout
            android:id="@+id/input_row"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_url"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/input_modern"
                android:fontFamily="monospace"
                android:gravity="center"
                android:hint="000000"
                android:importantForAutofill="no"
                android:inputType="number"
                android:letterSpacing="0.4"
                android:maxLength="12"
                android:singleLine="true"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink_faint"
                android:textSize="26sp"
                android:textStyle="bold"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

            <Space
                android:layout_width="10dp"
                android:layout_height="match_parent" />

            <FrameLayout
                android:id="@+id/btn_scan_qr_inline"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/btn_qr_modern"
                android:clickable="true"
                android:focusable="true">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_qr"
                    app:tint="@color/ink_muted"
                    android:importantForAccessibility="no" />
            </FrameLayout>
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
        android:layout_height="@dimen/space_4" />

        <!-- Name label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Nama Lengkap"
            android:textColor="@color/ink_muted"
            android:textSize="13sp"
            android:letterSpacing="0.02" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="8dp" />

        <EditText
            android:id="@+id/et_nama"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/input_modern"
            android:gravity="center_vertical"
            android:hint="Masukkan nama"
            android:importantForAutofill="no"
            android:inputType="textPersonName|textCapWords"
            android:maxLength="60"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_faint"
            android:textSize="15sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_3" />

        <!-- Number label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Nomor Peserta"
            android:textColor="@color/ink_muted"
            android:textSize="13sp"
            android:letterSpacing="0.02" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="8dp" />

        <EditText
            android:id="@+id/et_nomor"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/input_modern"
            android:gravity="center_vertical"
            android:hint="Masukkan nomor"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="20"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_faint"
            android:textSize="15sp" />

        <!-- Error text -->
        <TextView
            android:id="@+id/tv_field_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/danger"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Token hanya terdiri dari angka."
            tools:visibility="visible" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_5" />

        <!-- Submit button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_open"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/btn_primary_modern"
            android:fontFamily="sans-serif-medium"
            android:text="Masuk Ujian"
            android:textColor="@color/ink_inverse"
            android:textSize="16sp"
            android:textAllCaps="false" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_3" />

        <!-- Version -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/app_version"
            android:textColor="@color/ink_faint"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
