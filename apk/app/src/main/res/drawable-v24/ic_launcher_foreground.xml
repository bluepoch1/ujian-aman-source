<?xml version="1.0" encoding="utf-8"?>
<!--
  Ikon peluncur "Ujian Aman": lembar soal + gembok.

  Seluruh bentuk ditahan di dalam safe zone adaptive icon (lingkaran
  diameter 66 berpusat di 54,54). Sudut terjauh lembar kertas berjarak
  ~31,6 dari pusat, masih di bawah radius 33, jadi tidak akan terpotong
  mask peluncur bentuk apa pun.

  Detail sengaja dibatasi: dua garis teks dan satu gembok. Di 48dp
  detail yang lebih halus akan menyatu jadi bubur.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

    <!-- lembar kertas, sudut kanan-atas terlipat -->
    <path
        android:pathData="M39.5,30 L61,30 L72,41 L72,76.5 A3.5,3.5 0 0,1 68.5,80 L39.5,80 A3.5,3.5 0 0,1 36,76.5 L36,33.5 A3.5,3.5 0 0,1 39.5,30 Z"
        android:fillColor="#FFFFFF" />

    <!-- segitiga lipatan -->
    <path
        android:pathData="M61,30 L72,41 L61,41 Z"
        android:fillColor="#E2DFD8" />

    <!-- dua baris tulisan -->
    <path
        android:pathData="M43.9,39.1 L62,39.1 A1.9,1.9 0 0,1 62,42.9 L43.9,42.9 A1.9,1.9 0 0,1 43.9,39.1 Z"
        android:fillColor="#BCB8AF" />
    <path
        android:pathData="M43.9,46.6 L55,46.6 A1.9,1.9 0 0,1 55,50.4 L43.9,50.4 A1.9,1.9 0 0,1 43.9,46.6 Z"
        android:fillColor="#BCB8AF" />

    <!-- sengkang gembok -->
    <path
        android:pathData="M47,58 A7,7 0 0,1 61,58"
        android:strokeColor="#1F4B99"
        android:strokeWidth="4.8"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- badan gembok -->
    <path
        android:pathData="M46.2,58 L61.8,58 A3.2,3.2 0 0,1 65,61.2 L65,70.8 A3.2,3.2 0 0,1 61.8,74 L46.2,74 A3.2,3.2 0 0,1 43,70.8 L43,61.2 A3.2,3.2 0 0,1 46.2,58 Z"
        android:fillColor="#1F4B99" />

    <!-- lubang kunci -->
    <path
        android:pathData="M54,61 A2.4,2.4 0 1,1 54,65.8 A2.4,2.4 0 1,1 54,61 Z"
        android:fillColor="#FFFFFF" />
    <path
        android:pathData="M52.7,64.5 L55.3,64.5 L55.3,68.7 A1.3,1.3 0 0,1 52.7,68.7 Z"
        android:fillColor="#FFFFFF" />
