<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_raised" />
            <stroke android:width="2dp" android:color="@color/accent" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
    <item android:state_hovered="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_raised" />
            <stroke android:width="1dp" android:color="@color/accent_border" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_sunken" />
            <stroke android:width="1dp" android:color="@color/border_strong" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
</selector>