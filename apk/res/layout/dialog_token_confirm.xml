<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/space_6"
    android:layout_marginEnd="@dimen/space_6"
    android:background="@drawable/surface_dialog"
    android:orientation="vertical"
    android:padding="@dimen/space_6">

    <TextView
        style="@style/Text.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/confirm_title" />

    <TextView
        android:id="@+id/tv_kelas"
        style="@style/Text.Display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:textSize="22sp"
        tools:text="XII IPA 2 — Matematika Wajib" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/hairline"
        android:layout_marginTop="@dimen/space_4"
        android:layout_marginBottom="@dimen/space_4"
        android:background="@color/border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="1dp"
            android:src="@drawable/ic_clock"
            app:tint="@color/ink_faint"
            android:importantForAccessibility="no" />

        <TextView
            style="@style/Text.Body"
            android:layout_width="88dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:text="@string/confirm_duration"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_durasi"
            style="@style/Text.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/ink"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="90 menit" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_3"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="1dp"
            android:src="@drawable/ic_calendar"
            app:tint="@color/ink_faint"
            android:importantForAccessibility="no" />

        <TextView
            style="@style/Text.Body"
            android:layout_width="88dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:text="@string/confirm_expires"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_expired"
            style="@style/Text.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/ink"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="12 Sep 2026, 10:30" />
    </LinearLayout>

    <TextView
        style="@style/Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:background="@drawable/chip_warning"
        android:padding="@dimen/space_3"
        android:text="@string/confirm_notice"
        android:textColor="@color/warning" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_mulai_ujian"
        style="@style/Button.Primary"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/space_4"
        android:text="@string/confirm_start" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_batal_token"
        style="@style/Button.Ghost"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/space_1"
        android:text="@string/confirm_cancel" />

</LinearLayout>